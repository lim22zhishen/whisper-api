# Copy to .env on the server. Keep .env private.

# 0.0.0.0 listens on the network. A key is then required, or the server won't start.
WHISPER_HOST=0.0.0.0
WHISPER_PORT=8000
# Required when listening on the network: at least 16 random characters.
WHISPER_API_KEY=

# cuda fails at startup if the GPU isn't working, instead of quietly running slow on CPU.
WHISPER_DEVICE=cuda
WHISPER_MODEL=large-v3
# float16 needs the most GPU memory. Use int8_float16 if the GPU runs out of memory.
WHISPER_COMPUTE_TYPE=float16
# Where the 3.09 GB model is stored. Empty uses the Hugging Face cache.
WHISPER_MODEL_DIR=models

# Terms to help the model recognise, comma separated, e.g. product or company names.
WHISPER_HOTWORDS=

# Files transcribed at the same time, and how many more may wait.
WHISPER_WORKERS=1
WHISPER_MAX_QUEUE=16
WHISPER_MAX_UPLOAD_MB=500
